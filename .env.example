# =============================================================================
# ER-PLATFORM-001 · environment template
# Copy to .env and adjust. .env is gitignored; this file is not.
# =============================================================================

# --- Postgres container provisioning (consumed by docker-compose.yml) --------
# POSTGRES_USER is the schema OWNER. It runs migrations and nothing else.
POSTGRES_USER=er_owner
POSTGRES_PASSWORD=er_owner_dev_pw
POSTGRES_DB=entity_resolution
POSTGRES_PORT=5432

# Three roles, one per plane. See docker/postgres/initdb/002_app_role.sh for
# why this split is load-bearing and not ceremony.
#
#   er_app      DATA PLANE    — API + workers. NOBYPASSRLS. Every FIG 2.8
#                               policy binds to this role.
#   er_platform CONTROL PLANE — BYPASSRLS. Tenant provisioning, dead-letter
#                               triage, retrain fan-out. Nothing else.
APP_DB_ROLE=er_app
APP_DB_PASSWORD=er_app_dev_pw
PLATFORM_DB_ROLE=er_platform
PLATFORM_DB_PASSWORD=er_platform_dev_pw

# --- Application connection strings ------------------------------------------
# DATABASE_URL is what FastAPI and the queue workers use. It MUST point at the
# data-plane role. Pointing it at the owner or the platform role is how tenant
# isolation is lost silently — FORCE ROW LEVEL SECURITY in migration 0002 is
# there to catch exactly that mistake for the owner case.
DATABASE_URL=postgresql+psycopg://er_app:er_app_dev_pw@localhost:5432/entity_resolution

# Owner role. Alembic uses this one and only this one; it is not read by the
# API or the workers.
MIGRATION_DATABASE_URL=postgresql+psycopg://er_owner:er_owner_dev_pw@localhost:5432/entity_resolution

# Control-plane role. Optional — leave blank and the cross-tenant helpers in
# app/db/session.py raise a clear error rather than falling back to a scoped
# connection and returning nothing.
PLATFORM_DATABASE_URL=postgresql+psycopg://er_platform:er_platform_dev_pw@localhost:5432/entity_resolution

# No broker: Postgres is also the task queue (task_queue, migration 0006).
# The queue worker claims through PLATFORM_DATABASE_URL, so it is required
# for `python -m app.queue.worker`.

# --- Auth (TRD 2.5) -----------------------------------------------------------
# HS256 with a shared secret is a development posture only. Production should
# move to RS256 + JWKS; app/core/security.py is written so that swap touches
# one function. tenant_id is read ONLY from the verified token, never from a
# request body or query parameter.
JWT_SECRET_KEY=change-me-dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
JWT_AUDIENCE=er-platform
JWT_ISSUER=er-platform-auth

# --- Application ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
SQL_ECHO=false

# --- ML pinning (TRD 2.2) -------------------------------------------------------
# Pinned by exact revision, not just name: a silent upstream model update must
# not silently reshuffle the meaning of every embedding already in the table.
# EMBEDDING_DIMENSIONS is NOT here on purpose — 768 is baked into the
# vector(768) column type, so changing it is a migration, not a setting.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# The main-branch commit of the model as of 2026-09. Pin to a commit hash;
# a branch name like "main" is not a pin.
EMBEDDING_MODEL_REVISION=4328cf26390c98c5e3c738b4460a05b95f4911f5

# --- Uploads ----------------------------------------------------------------------
# Fallback path: with no bucket configured below, POST /v1/jobs streams the
# CSV through the API and spools it here (fine for local development).
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=268435456

# Direct-to-bucket uploads (presigned PUT). Set bucket + keys to enable; the
# browser then uploads straight to storage and the API never carries bytes.
# Cloudflare R2 (free tier, no egress fees):
#   OBJECT_STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   OBJECT_STORAGE_REGION=auto
# AWS S3: leave the endpoint blank and set the bucket's region.
# The bucket needs a CORS rule for the frontend origin:
#   python scripts/configure_bucket_cors.py --origin http://localhost:3000
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
PRESIGNED_URL_TTL_SECONDS=900

# --- Matching -----------------------------------------------------------------------
# Pseudo-label weight of the EM prior when steward labels update Splink's m.
FEEDBACK_PRIOR_STRENGTH=50

# --- Enrichment (zero-cost) ------------------------------------------------------------
# Any OpenAI-compatible endpoint. Blank = SERP+LLM enrichment off.
#   Groq:   https://api.groq.com/openai/v1   (+ LLM_API_KEY)
#   Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Put a real contact URL here before enabling any registry adapter.
ENRICHMENT_USER_AGENT=ER-Platform-Enrichment/1.0

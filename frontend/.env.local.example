# =============================================================================
# Frontend development environment.
#
# Copy to .env.local (gitignored by the Next.js scaffold's .gitignore).
#
# These are DEVELOPMENT credentials for a mock identity provider. There is no
# login screen because there is no IdP yet — src/lib/auth/dev-token.ts mints a
# token server-side that satisfies app/core/security.py. Replacing it with a
# real IdP is a change to that file and the /api/dev-token route, nothing else.
# =============================================================================

# Where the rewrite in next.config.ts forwards /v1/* to.
BACKEND_ORIGIN=http://localhost:8000

# Leave unset to use the same-origin proxy (recommended: the backend has no
# CORS middleware, so a direct cross-origin call is blocked by the browser).
# Set to http://localhost:8000/v1 only if you add CORS to FastAPI.
# NEXT_PUBLIC_API_BASE_URL=

# --- Mock JWT ----------------------------------------------------------------
# MUST match the backend's JWT_SECRET_KEY, or every request 401s with the
# deliberately uninformative "Invalid or expired token".
JWT_SECRET_KEY=change-me-dev-only-not-a-real-secret
JWT_AUDIENCE=er-platform
JWT_ISSUER=er-platform-auth

# MUST be a tenant row that actually exists: jobs.tenant_id is a foreign key,
# so an invented UUID passes JWT verification and then fails on insert.
# Create it with the psql one-liner in README.md.
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_SUBJECT=dev@example.com
# data_engineer | data_steward | org_admin. Feedback needs steward or admin.
DEV_ROLE=data_steward
